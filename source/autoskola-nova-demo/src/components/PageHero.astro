---
import { ArrowUpRight } from "@lucide/astro";
interface Props {
  eyebrow: string;
  title: string;
  text: string;
  image?: string;
  imageAlt?: string;
  cta?: string;
  href?: string;
}
const {
  eyebrow,
  title,
  text,
  image,
  imageAlt = "",
  cta,
  href = "/prihlaska/",
} = Astro.props;
---

<section class:list={["page-hero", { "page-hero-image": image }]}>
  <div class="shell page-hero-grid">
    <div class="page-hero-copy">
      <p class="eyebrow">{eyebrow}</p>
      <h1>{title}</h1>
      <p class="page-hero-text">{text}</p>
      {cta && (
        <a class="button button-lime" href={href}>
          {cta}
          <ArrowUpRight size={18} />
        </a>
      )}
    </div>
    {image && (
      <div class="page-hero-visual">
        <img src={image} alt={imageAlt} width="1536" height="1024" />
      </div>
    )}
  </div>
</section>
