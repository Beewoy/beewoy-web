---
interface Props {
  eyebrow: string;
  title: string;
  text?: string;
  light?: boolean;
}
const { eyebrow, title, text, light = false } = Astro.props;
---

<div class:list={["section-heading", { light }]}>
  <p class="eyebrow">{eyebrow}</p>
  <h2>{title}</h2>
  {text && <p class="section-lead">{text}</p>}
</div>
