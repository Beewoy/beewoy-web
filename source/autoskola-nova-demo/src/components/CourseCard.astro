---
import { ArrowUpRight } from "@lucide/astro";
import type { Course } from "../data/courses";
interface Props {
  course: Course;
  index?: number;
}
const { course, index = 0 } = Astro.props;
---

<article class="course-card">
  <a
    href={course.href}
    class="course-card-image"
    aria-label={`${course.id === "individualny-vycvik" ? "Dopyt k službe" : "Detail kurzu"} ${course.name}`}
  >
    <img
      src={course.image}
      alt={course.imageAlt}
      width="1536"
      height="1024"
      loading="lazy"
    />
    <span class="course-index">0{index + 1}</span>
  </a>
  <div class="course-card-content">
    <p class="eyebrow">{course.eyebrow}</p>
    <h3>{course.name}</h3>
    <p>{course.description}</p>
    <ul class="course-tags">
      {course.features.map((feature) => (
        <li>{feature}</li>
      ))}
    </ul>
    <div class="course-card-bottom">
      <div>
        <small>Ilustračná cena {course.priceNote}</small>
        <strong>{course.price}</strong>
      </div>
      <a class="course-card-link" href={course.href}>
        {course.id === "individualny-vycvik" ? "Opýtať sa" : "Detail kurzu"}
        <ArrowUpRight size={18} stroke-width={1.8} />
      </a>
    </div>
  </div>
</article>
