---
import SiteLayout from "../layouts/SiteLayout.astro";
import PageHero from "../components/PageHero.astro";
import { schoolConfig } from "../data/schoolConfig";
import { MapPin, ArrowUpRight } from "@lucide/astro";
---

<SiteLayout
  title="Kontakt"
  description="Ukážková kontaktná stránka fiktívnej Autoškoly NOVA. Telefón, e-mail a lokalita sú ilustračné; formulár nič neodosiela."
>
  <PageHero
    eyebrow="KONTAKT · UKÁŽKA"
    title="Poďme sa porozprávať."
    text="Pýtaš sa na kurz, termín alebo kondičné jazdy? Takto môže vyzerať jednoduchý kontakt s autoškolou. Údaje na tejto stránke sú len demo."
  />
  <section class="section">
    <div class="shell contact-grid">
      <div>
        <p class="eyebrow">KDE NÁS NÁJDEŠ</p>
        <h2 style="font-size:clamp(36px,4vw,56px);margin-bottom:26px">
          Jeden kontakt.
          <br />
          Jasná odpoveď.
        </h2>
        <div class="contact-lines">
          <div class="contact-line">
            <small>Telefón · ukážka</small>
            <strong>{schoolConfig.contact.phoneDisplay}</strong>
          </div>
          <div class="contact-line">
            <small>E-mail · neexistujúca demo adresa</small>
            <strong>{schoolConfig.contact.email}</strong>
          </div>
          <div class="contact-line">
            <small>Lokality · bez reálnej prevádzky</small>
            <strong>{schoolConfig.locations.join(" · ")}</strong>
          </div>
          <div class="contact-line">
            <small>Adresa prevádzky</small>
            <strong>{schoolConfig.contact.address}</strong>
          </div>
          <div class="contact-line">
            <small>Otváracie hodiny · ukážka</small>
            <strong>{schoolConfig.contact.hours}</strong>
          </div>
        </div>
      </div>
      <div class="form-card">
        <h2>Napíš ukážkovú správu</h2>
        <p>Tento formulár je iba ukážka. Údaje sa neodošlú ani neuložia.</p>
        <form class="demo-form" novalidate data-demo-form>
          <div class="field-grid">
            <div class="field">
              <label for="contact-name">Meno a priezvisko *</label>
              <input
                id="contact-name"
                name="name"
                autocomplete="name"
                required
                minlength="2"
              />
              <span class="field-error" data-error-for="name"></span>
            </div>
            <div class="field">
              <label for="contact-email">E-mail *</label>
              <input
                id="contact-email"
                name="email"
                type="email"
                autocomplete="email"
                required
              />
              <span class="field-error" data-error-for="email"></span>
            </div>
          </div>
          <div class="field">
            <label for="contact-message">Správa *</label>
            <textarea
              id="contact-message"
              name="message"
              required
              minlength="10"
              placeholder="Čo by si sa chcel opýtať?"
            ></textarea>
            <span class="field-error" data-error-for="message"></span>
          </div>
          <button class="button button-lime form-submit" type="button">
            Vyskúšať formulár <ArrowUpRight size={18} />
          </button>
          <div
            class="form-status"
            role="status"
            aria-live="polite"
            hidden
          ></div>
          <p class="form-disclaimer">
            Žiadne údaje sa neposielajú na server ani neukladajú.
          </p>
        </form>
      </div>
    </div>
  </section>
  <section class="section section-soft">
    <div class="shell">
      <div class="map-heading">
        <div>
          <p class="eyebrow">LOKALITA · UKÁŽKA</p>
          <h2>Bratislava na mape.</h2>
          <p>
            Mapa zobrazuje iba mesto. Autoškola NOVA je fiktívna a nemá tu
            označenú prevádzku.
          </p>
        </div>
        <a
          class="text-link"
          href="https://www.google.com/maps/search/?api=1&query=Bratislava%2C%20Slovensko"
          target="_blank"
          rel="noopener noreferrer"
        >
          <MapPin size={17} /> Otvoriť Google Mapy <ArrowUpRight size={17} />
        </a>
      </div>
      <div class="map-frame">
        <iframe
          title="Google mapa Bratislavy – ilustračná lokalita bez adresy autoškoly"
          src="https://www.google.com/maps?q=Bratislava%2C%20Slovensko&output=embed"
          loading="lazy"
          referrerpolicy="no-referrer-when-downgrade"
          allowfullscreen
        ></iframe>
      </div>
    </div>
  </section>
  <script src="../scripts/demoForms.ts"></script>
</SiteLayout>
