---
import SiteLayout from "../layouts/SiteLayout.astro";
import PageHero from "../components/PageHero.astro";
import CallToAction from "../components/CallToAction.astro";
import { courses } from "../data/courses";
import { ArrowUpRight, Check } from "@lucide/astro";

const groups = [
  {
    number: "01",
    title: "Vodičské kurzy skupiny B",
    description: "Pre tvoj prvý vodičák. Prevodovku si vyberieš pri prihláške.",
    items: courses.filter((course) =>
      ["skupina-b", "intenzivny-b"].includes(course.id),
    ),
  },
  {
    number: "02",
    title: "Jazdy podľa potreby",
    description: "Keď už vodičák máš alebo potrebuješ osobný plán.",
    items: courses.filter((course) =>
      ["kondicne-jazdy", "individualny-vycvik"].includes(course.id),
    ),
  },
];
---

<SiteLayout
  title="Cenník"
  description="Prehľadné ilustračné ceny kurzov skupiny B, kondičných jázd a individuálneho výcviku Autoškoly NOVA."
>
  <PageHero
    eyebrow="CENNÍK · ILUSTRAČNÉ CENY"
    title="Ceny, v ktorých sa vyznáš."
    text="Najprv si vyber cieľ. Hneď vedľa vidíš orientačnú cenu aj to, čo ukážková ponuka zahŕňa."
  />
  <section class="section">
    <div class="shell pricing-shell">
      <div class="pricing-intro">
        <p class="eyebrow">PREHĽAD PONUKY</p>
        <h2>Štyri možnosti. Jeden prehľad.</h2>
        <p>
          Ceny sú súčasťou dema fiktívnej autoškoly. Rozsah a konečnú cenu by
          vždy potvrdila skutočná prevádzka.
        </p>
      </div>
      <div class="pricing-groups">
        {groups.map((group) => (
          <section class="pricing-group" aria-label={group.title}>
            <div class="pricing-group-heading">
              <span>{group.number}</span>
              <div>
                <h3>{group.title}</h3>
                <p>{group.description}</p>
              </div>
            </div>
            <div class="pricing-rows">
              {group.items.map((course) => (
                <article class="pricing-row">
                  <div class="pricing-row-main">
                    <p class="eyebrow">{course.eyebrow}</p>
                    <h4>{course.name}</h4>
                    <p>{course.description}</p>
                    <ul>
                      {course.includes.map((item) => (
                        <li>
                          <Check size={15} />
                          {item}
                        </li>
                      ))}
                    </ul>
                  </div>
                  <div class="pricing-row-side">
                    <small>Ilustračná cena {course.priceNote}</small>
                    <strong>{course.price}</strong>
                    <a href={course.href}>
                      {course.id === "individualny-vycvik"
                        ? "Opýtať sa"
                        : "Pozrieť detail"}
                      <ArrowUpRight size={17} />
                    </a>
                  </div>
                </article>
              ))}
            </div>
          </section>
        ))}
      </div>
      <div class="pricing-note">
        <strong>Manuál alebo automat?</strong>
        <p>
          Pri oboch kurzoch skupiny B si prevodovku vyberieš v prihláške. Za
          automat je v tejto ukážke príplatok 100 €. Dostupnosť vozidla aj
          konečnú cenu by potvrdila autoškola.
        </p>
      </div>
    </div>
  </section>
  <CallToAction
    title="Našiel si svoju cestu?"
    button="Ukážková prihláška"
    href="/prihlaska/"
  />
</SiteLayout>
