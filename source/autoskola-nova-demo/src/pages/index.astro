---
import SiteLayout from "../layouts/SiteLayout.astro";
import SectionHeading from "../components/SectionHeading.astro";
import CourseCard from "../components/CourseCard.astro";
import TermList from "../components/TermList.astro";
import Faq from "../components/Faq.astro";
import CallToAction from "../components/CallToAction.astro";
import { courses } from "../data/courses";
import { instructors } from "../data/instructors";
import { vehicles } from "../data/vehicles";
import { reviews } from "../data/reviews";
import { schoolConfig } from "../data/schoolConfig";
import {
  ArrowUpRight,
  ArrowRight,
  CalendarDays,
  CarFront,
  Clock3,
  Handshake,
  MapPin,
  Route,
  ShieldCheck,
} from "@lucide/astro";
---

<SiteLayout
  title="Tvoj vodičák. Tvoja cesta."
  description="Ukážkový moderný web autoškoly v Bratislave. Prezri si kurzy, ilustračné ceny a termíny na jednom mieste."
>
  <section class="hero">
    <div class="shell hero-grid">
      <div class="hero-copy">
        <p class="eyebrow">
          AUTOŠKOLA · {schoolConfig.locations.join(" / ").toUpperCase()} · DEMO
        </p>
        <h1>
          Autoškola pre
          <br />
          <span>tvoj vodičák.</span>
        </h1>
        <p>
          Kurzy skupiny B v Bratislave na manuáli aj automate. Pozri si ceny,
          najbližšie termíny a vyber si výcvik, s ktorým získaš istotu za
          volantom.
        </p>
        <div class="hero-actions">
          <a class="button button-lime" href="/kurzy/">
            Vybrať kurz <ArrowUpRight size={18} />
          </a>
          <a class="button button-outline" href="/cennik/">
            Pozrieť cenník <ArrowRight size={17} />
          </a>
        </div>
      </div>
    </div>
    <nav class="quick-actions" aria-label="Rýchle akcie">
      <div class="shell quick-actions-inner">
        <a href="/#ako-to-funguje" class="quick-action">
          <span>
            <Route size={22} />
            <ArrowUpRight class="quick-arrow" size={18} />
          </span>
          <span>
            <strong>Ako to funguje</strong>
            <small>Od prihlášky po skúšku</small>
          </span>
        </a>
        <a href="/#terminy" class="quick-action">
          <span>
            <CalendarDays size={21} />
            <ArrowUpRight class="quick-arrow" size={18} />
          </span>
          <span>
            <strong>Najbližšie termíny</strong>
            <small>Pozri, kedy začať</small>
          </span>
        </a>
        {courses.some((course) => course.id === "kondicne-jazdy") ? (
          <a href="/kondicne-jazdy/" class="quick-action">
            <span>
              <CarFront size={22} />
              <ArrowUpRight class="quick-arrow" size={18} />
            </span>
            <span>
              <strong>Kondičné jazdy</strong>
              <small>Vráť sa za volant</small>
            </span>
          </a>
        ) : (
          <a href="/prihlaska/" class="quick-action">
            <span>
              <CarFront size={22} />
              <ArrowUpRight class="quick-arrow" size={18} />
            </span>
            <span>
              <strong>Prihláška</strong>
              <small>Urob prvý krok</small>
            </span>
          </a>
        )}
        <a href="/kontakt/" class="quick-action">
          <span>
            <MapPin size={21} />
            <ArrowUpRight class="quick-arrow" size={18} />
          </span>
          <span>
            <strong>Kontakt</strong>
            <small>Napíš nám v deme</small>
          </span>
        </a>
      </div>
    </nav>
  </section>
  <section class="section section-soft" id="kurzy">
    <div class="shell">
      <SectionHeading
        eyebrow="KURZY"
        title="Vyber si kurz, ktorý ti sedí."
        text="Štyri možnosti od prvého vodičáku po návrat za volant. Prevodovku si vyberieš až pri prihláške."
      />
      <div class="courses-grid">
        {courses.map((course, index) => (
          <CourseCard course={course} index={index} />
        ))}
      </div>
      <p class="demo-note">Ceny, rozsah a dostupnosť kurzov sú ilustračné.</p>
    </div>
  </section>
  <section class="section" id="terminy">
    <div class="shell">
      <div style="display:flex;justify-content:space-between;align-items:end;gap:20px;flex-wrap:wrap">
        <SectionHeading
          eyebrow="TERMÍNY"
          title="Kedy môžeš začať?"
          text="Pozri si ukážkové začiatky kurzu skupiny B. Manuál alebo automat si vyberieš až pri prihláške."
        />
        <a class="text-link" href="/prihlaska/">
          Prejsť na prihlášku <ArrowUpRight size={17} />
        </a>
      </div>
      <TermList />
    </div>
  </section>
  <section class="section section-soft">
    <div class="shell editorial-split">
      <div class="editorial-image">
        <img
          src="/images/lesson.jpg"
          alt="Ilustračná scéna pokojnej výučby jazdy s inštruktorom"
          width="1536"
          height="1024"
          loading="lazy"
        />
      </div>
      <div class="editorial-copy">
        <p class="eyebrow">PRÍSTUP K VÝCVIKU</p>
        <h2>U nás nejde len o vodičák.</h2>
        <p>
          Dobrý pocit za volantom vzniká postupne. Preto je ukážkový prístup
          NOVA postavený na jasných krokoch, trpezlivom vysvetlení a jazdách v
          skutočnej premávke.
        </p>
        <div class="feature-list">
          <div>
            <Handshake size={24} />
            <h3>Osobný prístup</h3>
            <p>Priestor na otázky aj vlastné tempo učenia.</p>
          </div>
          <div>
            <CarFront size={24} />
            <h3>Moderné autá</h3>
            <p>Bežné kompaktné vozidlá na reálne cesty.</p>
          </div>
          <div>
            <ShieldCheck size={24} />
            <h3>Pokojná výučba</h3>
            <p>Jasná spätná väzba po každej jazde.</p>
          </div>
          <div>
            <Clock3 size={24} />
            <h3>Termíny na výber</h3>
            <p>Rýchly prehľad plánovaných štartov kurzu.</p>
          </div>
        </div>
        <a class="text-link" href="/o-nas/">
          Viac o našom prístupe <ArrowUpRight size={17} />
        </a>
      </div>
    </div>
  </section>
  <section class="section section-dark" id="ako-to-funguje">
    <div class="shell">
      <SectionHeading
        eyebrow="AKO TO FUNGUJE"
        title="Od prihlášky až za volant."
        text="Vieš, čo ťa čaká v každom kroku. Bez zbytočných prekvapení."
        light={true}
      />
      <div class="timeline">
        <div class="timeline-step">
          <span>01</span>
          <h3>Vyber si kurz.</h3>
          <p>
            Vyber si kurz skupiny B, kondičné jazdy alebo individuálnu možnosť.
          </p>
        </div>
        <div class="timeline-step">
          <span>02</span>
          <h3>Pošli prihlášku.</h3>
          <p>V tomto deme si vyskúšaš podobu budúcej prihlášky.</p>
        </div>
        <div class="timeline-step">
          <span>03</span>
          <h3>Absolvuj výcvik.</h3>
          <p>Teória a jazdy ti pomôžu budovať istotu krok za krokom.</p>
        </div>
        <div class="timeline-step">
          <span>04</span>
          <h3>Priprav sa na skúšku.</h3>
          <p>Prejdi si témy, ktoré ešte potrebuješ upevniť.</p>
        </div>
      </div>
    </div>
  </section>
  {instructors.length > 0 && (
    <section class="section">
      <div class="shell">
        <SectionHeading
          eyebrow="ĽUDIA"
          title="Ľudia, s ktorými budeš jazdiť."
          text="Ukážkové profily ukazujú, ako môžu byť inštruktori predstavení v ostrej verzii webu."
        />
        <div class="portrait-grid">
          {instructors.map((person) => (
            <article class="portrait-card">
              <img
                src={person.image}
                alt={`Ilustračná fotografia profilu ${person.name}`}
                width="1024"
                height="1536"
                loading="lazy"
                style={`object-position:${person.position}`}
              />
              <div class="portrait-card-body">
                <h3>{person.name}</h3>
                <small>{person.role}</small>
                <p>{person.text}</p>
              </div>
            </article>
          ))}
        </div>
        <p class="demo-note">
          Mená, fotografie aj popisy profilov sú ilustračné a nepredstavujú
          skutočný tím.
        </p>
      </div>
    </section>
  )}
  {vehicles.length > 0 && (
    <section class="section section-soft">
      <div class="shell">
        <SectionHeading
          eyebrow="VOZIDLÁ"
          title="Na čom budeš jazdiť?"
          text="Malé a prehľadné autá pre veľké prvé kroky. Konkrétne modely by doplnila reálna autoškola."
        />
        <div class="vehicle-grid">
          {vehicles.map((vehicle) => (
            <article class="vehicle-card">
              <img
                src={vehicle.image}
                alt={`Ilustračné výcvikové vozidlo: ${vehicle.gearbox}`}
                width="1536"
                height="1024"
                loading="lazy"
              />
              <div class="vehicle-card-content">
                <p class="eyebrow" style="color:#c8ff3d;margin-bottom:8px">
                  ILUSTRAČNÉ VOZIDLO
                </p>
                <h3>{vehicle.name}</h3>
                <p>
                  {vehicle.gearbox} · {vehicle.text}
                </p>
              </div>
            </article>
          ))}
        </div>
      </div>
    </section>
  )}
  {reviews.length > 0 && (
    <section class="section">
      <div class="shell">
        <SectionHeading
          eyebrow="REFERENCIE"
          title="Miesto pre skúsenosti absolventov."
          text="Tri ukážkové texty ukazujú podobu recenzií. V reálnom webe ich nahradia overené hodnotenia absolventov."
        />
        <div class="review-grid">
          {reviews.map((review, index) => (
            <figure class="quote-demo">
              <p class="eyebrow">UKÁŽKOVÁ RECENZIA · 0{index + 1}</p>
              <blockquote>{review.quote}</blockquote>
              <figcaption>{review.attribution}</figcaption>
            </figure>
          ))}
        </div>
      </div>
    </section>
  )}
  <section class="section section-soft">
    <div class="shell" style="max-width:1100px">
      <SectionHeading
        eyebrow="FAQ"
        title="Často sa nás pýtate."
        text="Rýchle odpovede predtým, než sa rozhodneš."
      />
      <Faq />
      <div style="margin-top:27px">
        <a class="text-link" href="/kontakt/">
          Máš inú otázku? Prejdi na kontakt <ArrowUpRight size={17} />
        </a>
      </div>
    </div>
  </section>
  <CallToAction />
</SiteLayout>
