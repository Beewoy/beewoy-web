---
import SiteLayout from "../../layouts/SiteLayout.astro";
import PageHero from "../../components/PageHero.astro";
import SectionHeading from "../../components/SectionHeading.astro";
import CourseCard from "../../components/CourseCard.astro";
import TermList from "../../components/TermList.astro";
import CallToAction from "../../components/CallToAction.astro";
import { courses } from "../../data/courses";
import { ArrowUpRight } from "@lucide/astro";
---

<SiteLayout
  title="Kurzy"
  description="Prezri si vodičský kurz skupiny B s voľbou manuálu alebo automatu, kondičné jazdy a individuálny výcvik. Ilustračné ceny v deme Autoškoly NOVA."
>
  <PageHero
    eyebrow="VYBER SI SVOJU CESTU"
    title="Kurz, ktorý sedí tebe."
    text="Prvý vodičák alebo návrat za volant. Pri kurze skupiny B si prevodovku vyberieš počas prihlásenia."
    image="/images/interior.jpg"
    imageAlt="Ilustračný pohľad z interiéru auta počas jazdy v meste"
    cta="Porovnať ceny"
    href="/cennik/"
  />
  <section class="section">
    <div class="shell">
      <SectionHeading
        eyebrow="PONUKA"
        title="Vyber si svoju cestu."
        text="Každú možnosť sme zhrnuli tak, aby si rýchlo videl, pre koho je určená a koľko stojí."
      />
      <div class="courses-grid">
        {courses.map((course, index) => (
          <CourseCard course={course} index={index} />
        ))}
      </div>
      <p class="demo-note">
        Ceny a služby sú ilustračné údaje fiktívnej autoškoly.
      </p>
    </div>
  </section>
  {courses.some((course) => course.id === "skupina-b") && (
      <section class="section section-soft">
        <div class="shell">
          <SectionHeading
            eyebrow="POROVNANIE"
            title="Manuál alebo automat?"
            text="V tejto ukážkovej ponuke majú oba varianty spoločné termíny začiatku. Prevodovku si vyberieš pri prihlásení."
          />
          <div class="info-strip">
            <div>
              <h3>Manuál</h3>
              <p>
                Učíš sa radiť a pracovať so spojkou. Vhodný, ak chceš skúsenosť
                s manuálnou prevodovkou.
              </p>
              <a class="text-link" href="/kurzy/skupina-b/#prevodovka">
                Detail kurzu <ArrowUpRight size={16} />
              </a>
            </div>
            <div>
              <h3>Automat</h3>
              <p>
                Bez radenia a spojky sa môžeš viac sústrediť na premávku. Skúška
                na automate obmedzí oprávnenie na automatické vozidlá.
              </p>
              <a class="text-link" href="/kurzy/skupina-b/#prevodovka">
                Detail kurzu <ArrowUpRight size={16} />
              </a>
            </div>
            {courses.some((course) => course.id === "kondicne-jazdy") && (
              <div>
                <h3>Už máš vodičák?</h3>
                <p>
                  Kondičné jazdy pomáhajú vrátiť sa za volant po prestávke alebo
                  precvičiť konkrétnu situáciu.
                </p>
                <a class="text-link" href="/kondicne-jazdy/">
                  Kondičné jazdy <ArrowUpRight size={16} />
                </a>
              </div>
            )}
          </div>
        </div>
      </section>
    )}
  <section class="section">
    <div class="shell">
      <SectionHeading
        eyebrow="UKÁŽKOVÉ TERMÍNY"
        title="Začať môžeš čoskoro."
        text="Spoločné začiatky kurzu skupiny B. Prevodovku si vyberieš v prihláške."
      />
      <TermList />
    </div>
  </section>
  <CallToAction
    title="Vieš, ktorý kurz je tvoj?"
    text="Prejdi si ukážkovú prihlášku a pozri, aké jednoduché môže byť prihlásenie."
    button="Otvoriť prihlášku"
    href="/prihlaska/"
  />
</SiteLayout>
