{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "beewoy-web",
  "compatibility_date": "2026-07-31",
  "observability": {
    "enabled": true
  },
  "assets": {
    "directory": ".",
    // Serve /404.html with HTTP 404 for unmatched paths (default is empty body).
    "not_found_handling": "404-page"
  }
}
